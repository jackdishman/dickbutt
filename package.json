{
  "name": "dickbutt-rewards-calculator",
  "version": "2.0.0",
  "description": "DICKBUTT fee harvesting, Splits protocol routing, TWAB rewards, deployment rehearsal and a local control console",
  "type": "module",
  "main": "calculate-rewards.js",
  "scripts": {
    "calculate": "node calculate-rewards.js",
    "console": "node ui/server.mjs",
    "rebuild-state": "node calculate-rewards.js rebuild-state",
    "test": "node --test calculator/test/*.test.js test/golden.test.mjs keeper/test/*.test.js operations/test/*.test.js ui/test/*.test.js",
    "rehearse": "node script/rehearse.mjs",
    "keeper": "node script/run-keeper.mjs",
    "fees": "node script/run-fees.mjs",
    "floor": "node script/run-floor.mjs",
    "monitor": "node script/run-monitor.mjs",
    "schedule": "node script/render-schedule.mjs",
    "deploy:sepolia": "node script/deploy-sepolia.mjs",
    "preflight": "node script/preflight.mjs",
    "inspect:legacy": "node script/inspect-legacy.mjs",
    "wallets:check": "node script/check-wallets.mjs"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.0.2",
    "@openzeppelin/merkle-tree": "1.0.8",
    "dotenv": "16.4.5",
    "ethers": "6.17.0"
  },
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "@metamask/utils": {
      "uuid": "11.1.1"
    }
  }
}
